model Page {
  id    Int    @id @default(autoincrement())
  title String
  slug  String // e.g., "about-me"

  // Relations
  projectId   Int
  project     Project    @relation(fields: [projectId], references: [id])
  siteId      Int?
  site        Site?      @relation(fields: [siteId], references: [id])
  mobileAppId Int?
  mobileApp   MobileApp? @relation(fields: [mobileAppId], references: [id])

  sections   Section[]
  subPages   Page[]    @relation("SubPages")
  parentId   Int?
  parentPage Page?     @relation("SubPages", fields: [parentId], references: [id])

  // SEO Fields
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  keywords        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@unique([slug, projectId])
}

model Section {
  id    Int         @id @default(autoincrement())
  type  SectionType
  name  String?
  order Int         @default(0)

  pageId Int
  page   Page @relation(fields: [pageId], references: [id])

  contents SectionContentItem[]

  // Layout Options
  containerType ContainerType @default(FULL)
  columnLayout  ColumnLayout?
  parentId      Int?
  parentSection Section?  @relation("SubSections", fields: [parentId], references: [id])
  subSections   Section[] @relation("SubSections")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum SectionType {
  HERO
  BACKGROUND_IMAGE
  BACKGROUND_VIDEO
  SPLIT_IMAGE_TEXT
  LIST
  GRID
  GALLERY
  BANNER
  CONTACT
  CTA
  TESTIMONIAL
  OTHER
}

// Join table linking sections to content items with ordering
model SectionContentItem {
  sectionId Int
  section   Section @relation(fields: [sectionId], references: [id])
  contentId Int
  content   Content @relation(fields: [contentId], references: [id])
  order     Int     @default(0)

  @@id([sectionId, contentId])
}

enum ContainerType {
  ROW
  COLUMN
  GRID
  FULL
}

enum ColumnLayout {
  ONE_THIRD_TWO_THIRDS
  TWO_THIRDS_ONE_THIRD
  HALF_HALF
  EQUAL_THIRDS
  EQUAL_QUARTERS
  FULL
  AUTO
}

model Content {
  id         Int               @id @default(autoincrement())
  type       ContentType       @default(POST)
  state      ContentState      @default(DRAFT)
  visibility ContentVisibility @default(HIDDEN)

  // Core metadata
  slug  String?
  title String?

  projectId Int
  project   Project @relation(fields: [projectId], references: [id])

  versions     ContentVersion[]
  sectionItems SectionContentItem[]

  featuredMediaId Int?
  featuredMedia   Media? @relation("FeaturedMedia", fields: [featuredMediaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ContentType {
  POST
  ALBUM
  TEXT
  OTHER
}

model ContentVersion {
  id        Int     @id @default(autoincrement())
  contentId Int
  content   Content @relation(fields: [contentId], references: [id])
  version   Int     @default(1)

  // The actual data snapshot
  title   String?
  body    Json?
  excerpt String?

  state      ContentState      @default(DRAFT)
  visibility ContentVisibility @default(HIDDEN)

  media ContentVersionMedia[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contentId, version])
}

model ContentVersionMedia {
  contentVersionId Int
  contentVersion   ContentVersion @relation(fields: [contentVersionId], references: [id])
  mediaId          Int
  media            Media          @relation(fields: [mediaId], references: [id])
  order            Int            @default(0)

  @@id([contentVersionId, mediaId])
}

model Media {
  id      Int       @id @default(autoincrement())
  type    MediaType @default(IMAGE)
  ownerId Int
  owner   Client    @relation(fields: [ownerId], references: [id])

  // File details
  url      String
  filename String?
  mimeType String?
  size     Int? // In bytes
  width    Int? // For images/videos
  height   Int? // For images/videos

  altText String?
  caption String?

  projectId Int
  project   Project @relation(fields: [projectId], references: [id])

  contentVersions ContentVersionMedia[]
  featuredIn      Content[]             @relation("FeaturedMedia")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  ARCHIVE
  OTHER
}

enum ContentState {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentVisibility {
  HIDDEN
  VISIBLE
  PASSWORD_PROTECTED
}
